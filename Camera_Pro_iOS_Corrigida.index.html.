<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#000"><title>Câmera Pro iOS Style</title>
<script src="https://cdn.tailwindcss.com"></script><script src="https://unpkg.com/lucide@latest"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#000;color:#fff;font-family:Inter,sans-serif;overflow:hidden;user-select:none;-webkit-user-select:none;touch-action:manipulation}.ios-slider{appearance:none;height:5px;border-radius:99px;background:#3f3f46}.ios-slider::-webkit-slider-thumb{appearance:none;width:20px;height:20px;border-radius:50%;background:#facc15}.drawer-transition{transition:transform .35s cubic-bezier(.16,1,.3,1)}.no-scrollbar::-webkit-scrollbar{display:none}.no-scrollbar{scrollbar-width:none}#cameraFeed{transform-origin:center center}.flash{animation:flash .22s ease-out}@keyframes flash{from{opacity:1}to{opacity:0}}
</style></head>
<body class="w-screen h-screen flex flex-col justify-between relative">
<div id="flashOverlay" class="absolute inset-0 bg-white pointer-events-none opacity-0 z-[100]"></div><div id="toastMessage" class="absolute top-20 left-1/2 -translate-x-1/2 bg-black/80 text-white text-xs px-4 py-2 rounded-full border border-white/10 opacity-0 transition-opacity z-[110] pointer-events-none whitespace-nowrap">Pronto</div>
<header class="w-full px-5 py-3 flex items-center justify-between bg-gradient-to-b from-black/80 to-transparent z-30"><button onclick="toggleFlash()" class="w-10 h-10 rounded-full bg-black/50 flex items-center justify-center"><i data-lucide="zap-off"></i></button><button onclick="toggleLivePhoto()" id="livePhotoBtn" class="flex items-center gap-1.5 px-3 py-2 rounded-full bg-black/50 border border-white/15 text-zinc-400 text-xs font-semibold">● LIVE</button><button onclick="cycleResolution()" id="resIndicatorBtn" class="px-3 py-1.5 rounded-full bg-black/50 border border-white/15 text-[11px] font-bold text-amber-400">1080p</button><button onclick="toggleDrawer()" class="w-10 h-10 rounded-full bg-black/50 flex items-center justify-center"><i data-lucide="chevron-down"></i></button></header>
<section id="settingsDrawer" class="absolute top-0 left-0 w-full bg-zinc-950/95 border-b border-white/10 z-50 -translate-y-full drawer-transition p-5 pt-16 flex flex-col gap-4 max-h-[86vh] overflow-y-auto"><div class="flex justify-between items-center border-b border-zinc-800 pb-3"><h3 class="text-sm font-bold uppercase text-amber-400">Configurações</h3><button onclick="toggleDrawer()" class="p-2 bg-zinc-900 rounded-full">✕</button></div><div class="grid grid-cols-2 gap-3"><button onclick="toggleGrid()" class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-xs">Grade 3×3 <b id="gridStatus">DESL</b></button><button onclick="toggleTimer()" class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-xs">Temporizador <b id="timerStatus">OFF</b></button></div><div><label class="text-[11px] text-zinc-400 uppercase font-bold">Qualidade</label><div class="grid grid-cols-3 gap-2 mt-2"><button onclick="setResolution('720p')" class="py-3 rounded-lg bg-zinc-900 border border-zinc-800 text-xs">720p</button><button onclick="setResolution('1080p')" class="py-3 rounded-lg bg-zinc-900 border border-amber-400 text-xs">1080p</button><button onclick="setResolution('4K')" class="py-3 rounded-lg bg-zinc-900 border border-zinc-800 text-xs">4K*</button></div><p class="text-[10px] text-zinc-500 mt-2">A resolução depende do aparelho.</p></div><div class="space-y-3"><label class="text-[11px] text-zinc-400 uppercase font-bold">Imagem</label><div class="text-xs">Brilho <input class="ios-slider w-full" type="range" min="50" max="150" value="100" oninput="adjust('brightness',this.value)"></div><div class="text-xs">Contraste <input class="ios-slider w-full" type="range" min="50" max="150" value="100" oninput="adjust('contrast',this.value)"></div><div class="text-xs">Saturação <input class="ios-slider w-full" type="range" min="0" max="200" value="100" oninput="adjust('saturate',this.value)"></div></div></section>
<main class="relative flex-1 min-h-0 w-full flex items-center justify-center overflow-hidden bg-black"><div class="relative w-full h-full overflow-hidden flex items-center justify-center bg-zinc-950"><video id="cameraFeed" autoplay playsinline muted class="w-full h-full object-cover"></video><div id="gridOverlay" class="absolute inset-0 pointer-events-none hidden z-10 grid grid-cols-3 grid-rows-3"><div class="border-r border-b border-white/30"></div><div class="border-r border-b border-white/30"></div><div class="border-b border-white/30"></div><div class="border-r border-b border-white/30"></div><div class="border-r border-b border-white/30"></div><div class="border-b border-white/30"></div><div class="border-r border-white/30"></div><div class="border-r border-white/30"></div><div></div></div><div id="cameraPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-zinc-950 z-20"><div class="w-16 h-16 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center mb-4"><i data-lucide="camera" class="w-8 h-8 text-amber-400"></i></div><h2 class="text-lg font-semibold mb-1">Câmera Profissional</h2><p id="placeholderDesc" class="text-xs text-zinc-400 max-w-xs mb-5">Toque para permitir o acesso à câmera.</p><button onclick="startCamera()" class="px-6 py-3 rounded-full bg-amber-400 text-black font-bold text-sm">Ativar Câmera</button></div><div id="timerDisplay" class="absolute inset-0 flex items-center justify-center bg-black/40 text-white text-7xl font-bold hidden z-30">3</div><div id="recordingBadge" class="absolute top-4 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-red-600 text-white text-xs hidden z-30">● REC <span id="recordTime">00:00</span></div></div></main>
<footer class="w-full bg-black/95 pb-5 pt-3 px-5 flex flex-col gap-3 z-30"><div class="flex items-center justify-between px-2"><div class="flex items-center gap-2 bg-zinc-900 p-1 rounded-full border border-zinc-800"><button onclick="setZoom(1)" id="z1" class="w-8 h-8 rounded-full bg-amber-400 text-black text-xs">1×</button><button onclick="setZoom(2)" id="z2" class="w-8 h-8 rounded-full text-zinc-400 text-xs">2×</button><button onclick="setZoom(3)" id="z3" class="w-8 h-8 rounded-full text-zinc-400 text-xs">3×</button></div><span class="text-[10px] text-zinc-500">CÂMERA PRO</span></div><div class="flex items-center justify-center gap-7 text-[11px] font-semibold tracking-wider text-zinc-400"><button onclick="setMode('video')" id="mvideo">VÍDEO</button><button onclick="setMode('foto')" id="mfoto" class="text-amber-400">FOTO</button><button onclick="setMode('retrato')" id="mretrato">RETRATO</button></div><div class="flex items-center justify-between px-7 py-2"><button onclick="openGallery()" class="w-12 h-12 rounded-xl bg-zinc-900 border-2 border-white/30 overflow-hidden"><img id="thumb" src="https://placehold.co/100x100/18181b/71717a?text=+" class="w-full h-full object-cover"></button><button onclick="shutter()" class="w-20 h-20 rounded-full border-4 border-white flex items-center justify-center p-1 bg-black/20 active:scale-90"><div id="shutterInner" class="w-full h-full rounded-full bg-white"></div></button><button onclick="switchCamera()" class="w-12 h-12 rounded-full bg-zinc-900 border border-white/15 flex items-center justify-center"><i data-lucide="refresh-cw"></i></button></div></footer>
<div id="gallery" class="fixed inset-0 bg-black/95 z-[90] hidden flex flex-col justify-between p-5"><div class="flex justify-between"><b class="text-amber-400">GALERIA</b><button onclick="closeGallery()">✕</button></div><div class="flex-1 flex items-center justify-center"><img id="galleryImg" class="max-h-[70vh] max-w-full object-contain"></div><div class="flex justify-between"><button onclick="prevPhoto()" class="bg-zinc-800 p-3 rounded-xl">Anterior</button><a id="download" download="foto-camera-pro.jpg" class="bg-amber-400 text-black p-3 rounded-xl font-bold">Baixar foto</a><button onclick="nextPhoto()" class="bg-zinc-800 p-3 rounded-xl">Próxima</button></div></div><canvas id="captureCanvas" class="hidden"></canvas>
<script>
'use strict';lucide.createIcons();const $=id=>document.getElementById(id);const video=$('cameraFeed');let stream=null,facing='environment',zoom=1,mode='foto',resolution='1080p',timer=0,grid=false,live=false,brightness=100,contrast=100,saturate=100,photos=[],galleryIndex=0,recorder=null,chunks=[],recording=false,recInterval=null,seconds=0;
function toast(msg){$('toastMessage').textContent=msg;$('toastMessage').classList.remove('opacity-0');clearTimeout(window.toastT);window.toastT=setTimeout(()=>$('toastMessage').classList.add('opacity-0'),2400)}
function explainError(e){let msg='Falha ao iniciar a câmera.';if(!window.isSecureContext||!navigator.mediaDevices?.getUserMedia)msg='O Chrome bloqueou a câmera neste endereço. Abra esta página por HTTPS (não pelo arquivo local file://).';else if(e?.name==='NotAllowedError'||e?.name==='PermissionDeniedError')msg='A permissão foi negada. Libere Câmera para o Chrome nas configurações do Android e também para este site.';else if(e?.name==='NotFoundError'||e?.name==='DevicesNotFoundError')msg='O navegador não encontrou uma câmera disponível.';else if(e?.name==='NotReadableError'||e?.name==='TrackStartError')msg='A câmera está ocupada por outro aplicativo. Feche câmera, WhatsApp, Instagram e tente novamente.';else if(e?.name==='OverconstrainedError')msg='A qualidade solicitada não é compatível. Tente novamente com qualidade automática.';else if(e?.name==='SecurityError')msg='O navegador impediu o acesso por segurança. Use HTTPS e permita a câmera.';return msg}
async function startCamera(){try{toast('Solicitando acesso à câmera…');if(!navigator.mediaDevices?.getUserMedia){throw new Error('getUserMedia indisponível: origem insegura ou navegador incompatível')}stopCamera();let constraints={audio:false,video:{facingMode:{ideal:facing},width:{ideal:resolution==='4K'?3840:resolution==='720p'?1280:1920},height:{ideal:resolution==='4K'?2160:resolution==='720p'?720:1080}}};try{stream=await navigator.mediaDevices.getUserMedia(constraints)}catch(first){console.warn(first);stream=await navigator.mediaDevices.getUserMedia({audio:false,video:{facingMode:{ideal:facing}}})}video.srcObject=stream;video.muted=true;video.playsInline=true;await video.play();$('cameraPlaceholder').classList.add('hidden');applyVideo();toast('Câmera ativada!')}catch(e){console.error('Erro da câmera:',e);stopCamera();$('cameraPlaceholder').classList.remove('hidden');$('placeholderDesc').textContent=explainError(e);toast('Não foi possível abrir a câmera')}}
function stopCamera(){if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}video.pause();video.srcObject=null}
async function switchCamera(){facing=facing==='environment'?'user':'environment';await startCamera()}
function applyVideo(){video.style.transform=`scale(${zoom}) ${facing==='user'?'scaleX(-1)':''}`;video.style.filter=`brightness(${brightness}%) contrast(${contrast}%) saturate(${saturate}%)`}
function setZoom(n){zoom=n;[1,2,3].forEach(x=>$('z'+x).className=x===n?'w-8 h-8 rounded-full bg-amber-400 text-black text-xs':'w-8 h-8 rounded-full text-zinc-400 text-xs');applyVideo()}
function setMode(m){mode=m;['video','foto','retrato'].forEach(x=>$('m'+x).className=x===m?'text-amber-400 font-bold':'text-zinc-400');$('shutterInner').className=m==='video'&&recording?'w-8 h-8 rounded-md bg-red-600':'w-full h-full rounded-full bg-white'}
function toggleDrawer(){$('settingsDrawer').classList.toggle('-translate-y-full')}
function toggleFlash(){toast('O flash depende do suporte do aparelho e do navegador.')}
function toggleGrid(){grid=!grid;$('gridOverlay').classList.toggle('hidden',!grid);$('gridStatus').textContent=grid?'LIG':'DESL'}
function toggleTimer(){timer=timer===0?3:timer===3?10:0;$('timerStatus').textContent=timer?timer+'s':'OFF'}
function setResolution(r){resolution=r;$('resIndicatorBtn').textContent=r;if(stream)startCamera()}
function cycleResolution(){setResolution(resolution==='720p'?'1080p':resolution==='1080p'?'4K':'720p')}
function adjust(k,v){if(k==='brightness')brightness=+v;if(k==='contrast')contrast=+v;if(k==='saturate')saturate=+v;applyVideo()}
function toggleLivePhoto(){live=!live;$('livePhotoBtn').className=live?'px-3 py-2 rounded-full bg-amber-400/20 border border-amber-400 text-amber-400 text-xs font-bold':'px-3 py-2 rounded-full bg-black/50 border border-white/15 text-zinc-400 text-xs';toast(live?'Live ativado (captura de foto)':'Live desativado')}
async function countdown(){if(!timer)return true;$('timerDisplay').classList.remove('hidden');for(let i=timer;i>0;i--){$('timerDisplay').textContent=i;await new Promise(r=>setTimeout(r,1000))}$('timerDisplay').classList.add('hidden');return true}
function flash(){let f=$('flashOverlay');f.classList.remove('flash');void f.offsetWidth;f.classList.add('flash');setTimeout(()=>f.classList.remove('flash'),250)}
async function takePhoto(){if(!stream||!video.videoWidth){toast('Ative a câmera primeiro');return}await countdown();let c=$('captureCanvas'),w=video.videoWidth,h=video.videoHeight;c.width=w;c.height=h;let ctx=c.getContext('2d');ctx.save();if(facing==='user') {ctx.translate(w,0);ctx.scale(-1,1)}ctx.filter=`brightness(${brightness}%) contrast(${contrast}%) saturate(${saturate}%)`;ctx.drawImage(video,0,0,w,h);ctx.restore();let url=c.toDataURL('image/jpeg',.94);photos.unshift(url);$('thumb').src=url;flash();toast(live?'Live Photo simulada: foto salva':'Foto salva!')}
function supportedMime(){return ['video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm'].find(x=>window.MediaRecorder&&MediaRecorder.isTypeSupported(x))||''}
function startRecording(){if(!stream||!window.MediaRecorder){toast('Gravação não disponível');return}try{chunks=[];let mime=supportedMime();recorder=new MediaRecorder(stream,mime?{mimeType:mime}:undefined);recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};recorder.onstop=()=>{let blob=new Blob(chunks,{type:recorder.mimeType||'video/webm'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='video-camera-pro.webm';a.click();toast('Vídeo baixado')};recorder.start();recording=true;seconds=0;$('recordingBadge').classList.remove('hidden');$('shutterInner').className='w-8 h-8 rounded-md bg-red-600';recInterval=setInterval(()=>{$('recordTime').textContent=String(++seconds).padStart(2,'0')+'s'},1000);toast('Gravando…')}catch(e){toast('Não foi possível iniciar a gravação')}}
function stopRecording(){if(!recording)return;recording=false;clearInterval(recInterval);$('recordingBadge').classList.add('hidden');$('shutterInner').className='w-full h-full rounded-full bg-white';if(recorder&&recorder.state!=='inactive')recorder.stop()}
async function shutter(){if(mode==='video'){recording?stopRecording():startRecording()}else takePhoto()}
function openGallery(){if(!photos.length){toast('Nenhuma foto salva');return}galleryIndex=0;showGallery();$('gallery').classList.remove('hidden')}
function showGallery(){let p=photos[galleryIndex];$('galleryImg').src=p;$('download').href=p;$('download').download='foto-camera-pro.jpg'}function closeGallery(){$('gallery').classList.add('hidden')}function prevPhoto(){galleryIndex=(galleryIndex+1)%photos.length;showGallery()}function nextPhoto(){galleryIndex=(galleryIndex-1+photos.length)%photos.length;showGallery()}
document.addEventListener('visibilitychange',()=>{if(document.hidden&&recording)stopRecording()});window.addEventListener('beforeunload',()=>{stopRecording();stopCamera()});
</script></body></html>
